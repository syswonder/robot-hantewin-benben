<?xml version="1.0"?>
<robot name="hty_robot">
  <link name="base_link"/>
  <link name="livox_frame"/>
  <link name="imu_link"/>
  <joint name="livox_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
  </joint>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>
</robot>
